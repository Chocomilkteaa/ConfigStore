{
  "name": "@chocomilktea/config-store",
  "version": "0.0.1-dev.18",
  "type": "module",
  "exports": {
    "./tsconfig/base": "./dist/tsconfig/base.json",
    "./tsconfig/node": "./dist/tsconfig/node.json",
    "./eslint/base": "./dist/eslint/base.js",
    "./eslint/test": "./dist/eslint/test.js",
    "./eslint/react-vite": "./dist/eslint/react-vite.js",
    "./prettier/base": "./dist/prettier/base.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/tsconfig/ && cp src/tsconfig/*.json dist/tsconfig/",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:check": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.68.0"
  },
  "devDependencies": {
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2"
  },
  "peerDependencies": {
    "eslint": "^10.8.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
